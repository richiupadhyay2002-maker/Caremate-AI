# Caremate AI — Environment Configuration
# Copy to .env and fill in your API keys

# LLM Provider Selection
# Options: openai, anthropic, groq, mock (default: mock for zero-key operation)
CAREMATE_LLM_PROVIDER=mock

# Embedding Provider Selection
# Options: openai, sentence_transformers, mock (default: mock)
CAREMATE_EMBEDDING_PROVIDER=mock

# --- OpenAI ---
OPENAI_API_KEY=
CAREMATE_OPENAI_MODEL=gpt-4o-mini
CAREMATE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Anthropic ---
ANTHROPIC_API_KEY=
CAREMATE_ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- Groq ---
GROQ_API_KEY=
CAREMATE_GROQ_MODEL=llama-3.1-8b-instant

# --- Logging ---
CAREMATE_LOG_LEVEL=INFO
